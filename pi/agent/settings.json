{
  "lastChangelogVersion": "0.85.1",
  "theme": "moonlight",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "httpProxy": "http://127.0.0.1:7890",
  "packages": [
    "npm:pi-zentui",
    "npm:pi-mcp-adapter",
    "npm:@narumitw/pi-usage",
    "npm:pi-web-access",
    "npm:pi-image-view",
    "npm:pi-obsidian",
    "npm:pi-playpen",
    "npm:@tintinweb/pi-subagents",
    "npm:@juicesharp/rpiv-voice",
    "npm:@juicesharp/rpiv-i18n",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:@xynogen/pix-pretty",
    "npm:pi-md-friendly",
    "npm:@sevten/pi-data-masking",
    "git:github.com/s5unty/pi-guard"
  ],
  "terminal": {
    "imageWidthCells": 60,
    "showImages": false,
    "showTerminalProgress": false
  },
  "modelThinkingLevels": {
    "openai-codex/gpt-6-astra": "high"
  },
  "tuiMode": "fullscreen",
  "fullscreenExitOutput": "resume-hint",
  "fullscreenScrollbar": "auto",
  "images": {
    "autoResize": false
  },
  "showHardwareCursor": true,
  "hideThinkingBlock": true,
  "treeFilterMode": "no-tools",
  "doubleEscapeAction": "tree",
  "defaultProjectTrust": "ask",
  "npmCommand": [
    "npm",
    "--ignore-scripts",
    "--omit=dev"
  ],
  "shellCommandPrefix": "export DOCKER_HOST=unix:///run/docker.sock",
  "editorPaddingX": 0,
  "outputPad": 1,
  "guard": {
    "enabled": true,
    "rules": {
      "ask_user_question": "allow",
      "bash": {
        "backlog": "allow",
        "lark-cli": "allow"
      },
      "fetch_content": "allow",
      "get_search_content": "allow",
      "source_check": "allow",
      "todo": "allow",
      "web_search": "allow"
    },
    "profiles": {
      "sudo": {
        "bash": "ask",
        "write": "allow",
        "edit": "allow"
      },
      "root": "allow"
    },
    "shortcuts": {
      "sudo": "profile sudo",
      "root": "profile root",
      "yolo": "off"
    }
  }
}
