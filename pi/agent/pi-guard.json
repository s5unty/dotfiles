{
  "version": 1,
  "mode": "strict",
  "filesystem": {
    "deny": [
      "/.env",
      "/.env.*",
      "/.npmrc",
      "/.pypirc",
      "/*.pem",
      "/*.key",
      "/secrets/**",
      "/credentials/**"
    ],
    "workspaceAccess": "read-write"
  },
  "network": {
    "allowedHosts": [],
    "blockInternalRanges": true
  },
  "environment": {
    "allowFromHost": [
      "LANG",
      "LC_*",
      "TERM",
      "CI"
    ],
    "values": {
      "HOME": "/root",
      "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    }
  },
  "hostCommands": {},
  "externalTools": {
    "allow": [
      "mcp",
      "mcpScript",
      "mcp__grafana",
      "web_search",
      "source_check",
      "fetch_content",
      "get_search_content",
      "obsidian_list_vaults",
      "obsidian_list_notes",
      "obsidian_read",
      "obsidian_write",
      "obsidian_append",
      "obsidian_search",
      "obsidian_list_tags",
      "obsidian_list_backlinks",
      "obsidian_create_mermaid",
      "obsidian_create_canvas",
      "obsidian_create_kanban",
      "obsidian_create_project_dashboard",
      "obsidian_create_daily_note",
      "Agent",
      "SubagentWorkflow",
      "get_subagent_result",
      "steer_subagent",
      "source_check",
      "obsidian_list_vaults",
      "ask_user_question"
    ]
  },
  "userBash": "sandbox",
  "approvalTimeoutSeconds": 60
}
