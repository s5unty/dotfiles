            "archive.ubuntu.com",
            "security.ubuntu.com",
            "ppa.launchpad.net",
            "keyserver.ubuntu.com",
            "azure.archive.ubuntu.com",
            "api.snapcraft.io",
            "deb.debian.org",
            "security.debian.org",
            "keyring.debian.org",
            "packages.debian.org",
            "debian.map.fastlydns.net",
            "apt.llvm.org",
            "dl.fedoraproject.org",
            "mirrors.fedoraproject.org",
            "download.fedoraproject.org",
            "mirror.centos.org",
            "vault.centos.org",
            "dl-cdn.alpinelinux.org",
            "pkg.alpinelinux.org",
            "mirror.archlinux.org",
            "archlinux.org",
            "download.opensuse.org",
            "cdn.redhat.com",
