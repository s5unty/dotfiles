{
  "version": 1,
  "enabled": true,
  "defaultSandbox": "wind",
  "sandboxes": {
    "wind": {
      "projects": [
        {
          "root": ".",
          "access": "read-write"
        }
      ],
      "sandboxRuntime": {
        "network": {
          // https://docs.github.com/en/copilot/reference/copilot-allowlist-reference
          "allowedDomains": [
            // URL paths were reduced to hostnames because Playpen network rules are host-based.{{{1
            // GitHub /meta: domains.website + domains.copilot
            "*.github.com",
            "*.github.dev",
            "*.github.io",
            "*.githubassets.com",
            "*.githubusercontent.com",
            "default.exp-tas.com",
            "*.githubcopilot.com",
            // GitHub Copilot services
            "github.com",
            "github.githubassets.com",
            "avatars.githubusercontent.com",
            "api.github.com",
            "collector.github.com",
            "copilot-telemetry.githubusercontent.com",
            "copilot-proxy.githubusercontent.com",
            "origin-tracker.githubusercontent.com",
            "*.individual.githubcopilot.com",
            "*.business.githubcopilot.com",
            "*.enterprise.githubcopilot.com",
            "copilot-reports.github.com",
            // Playpen only supports whole-label wildcards; these broaden the source
            // patterns copilot-reports-*.b01.azurefd.net and
            // usagereports*.blob.core.windows.net / amlwlrt4*.blob.core.windows.net.
            "*.b01.azurefd.net",
            "*.blob.core.windows.net",
            "*.SUBDOMAIN.ghe.com",
            "SUBDOMAIN.ghe.com",
            // Editor-specific example explicitly named by the reference
            "vscode.dev",
            // Copilot voice features
            "ai.azure.com",
            "api.catalog.azureml.ms",
            "*.api.azureml.ms",
            // Azure infrastructure and certificate authorities
            "168.63.129.16",
            "crl3.digicert.com",
            "crl4.digicert.com",
            "ocsp.digicert.com",
            "ts-crl.ws.symantec.com",
            "ts-ocsp.ws.symantec.com",
            "s.symcb.com",
            "s.symcd.com",
            "crl.geotrust.com",
            "ocsp.geotrust.com",
            "crl.thawte.com",
            "ocsp.thawte.com",
