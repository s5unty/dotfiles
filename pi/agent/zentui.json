{
  "components": {
    "editor": {
      "enabled": true,
      "style": "minimalist",
      "colorSource": "terminal",
      "borderColorMode": "static",
      "modelLabel": "name",
      "viewportIndicators": false,
      "styles": {
        "opencode": {
          "metadataFormat": "$model  $provider(  $thinking)",
          "completionMenu": "palette"
        },
        "opencode-copy-friendly": {
          "metadataFormat": "$model  $provider(  $thinking)",
          "completionMenu": "palette"
        },
        "accent-rail": {
          "rail": "▎",
          "asciiRail": "|",
          "transparent": false
        },
        "minimalist": {
          "pathDisplay": "full",
          "contextFormat": "percent-total",
          "contextGauge": false,
          "showSessionName": true,
          "showTimer": false,
          "showCost": true,
          "showGit": false,
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "formats": {
            "bottomLeft": "$session_name"
          },
          "showCacheHit": false,
          "separator": "dash"
          }
      },
      "codexQuota": false
    },
    "userMessages": {
      "enabled": false,
      "style": "compact",
      "colorSource": "terminal",
      "styles": {
        "framed": {},
        "framed-copy-friendly": {},
        "compact": {},
        "labeled": {}
      }
    },
    "workingLine": {
      "enabled": true,
      "turnSummary": false,
      "spinner": "braille",
      "spinnerIntervalMs": 100,
      "animateSpinnerColor": true,
      "textIntervalMs": 60,
      "textAnimation": "disabled",
      "colorSource": "terminal",
      "messages": {
        "custom": false,
        "values": [
          "Sautéing…",
          "Cooking…",
          "Ionizing…",
          "Zigzagging…",
          "Razzle-dazzling…",
          "Photosynthesizing…",
          "Nucleating…",
          "Brewing…",
          "Combobulating…",
          "Boogieing…",
          "Befuddling…",
          "Alchemizing…",
          "Conjuring…",
          "Baking…",
          "Simmering…",
          "Blanching…"
        ]
      },
      "segments": {
        "tool": true,
        "elapsed": true,
        "thought": true,
        "tokens": true
      }
    },
    "footer": {
      "style": "starship",
      "colorSource": "terminal",
      "modelLabel": "id",
      "styles": {
        "starship": {
          "format": "",
          "responsive": false,
          "compactFormat": "$cwd$wrap(in $session_name)$wrap(on $git_branch) $git_status$wrap$context$wrap_sep$tokens",
          "compactMaxLines": 1,
          "separator": "pipe",
          "contextStyle": "text",
          "contextThresholds": {
            "warning": 70,
            "error": 90
          },
          "pathDisplay": {
            "mode": "basename",
            "depth": 0
          },
          "segments": {
            "cwd": false,
            "sessionName": true,
            "gitBranch": true,
            "gitStatus": true,
            "gitCounts": true,
            "gitCommit": true,
            "gitMetrics": false,
            "runtime": true,
            "modelInfo": false,
            "context": false,
            "tokens": true,
            "cost": false,
            "sessionDuration": false,
            "username": false,
            "time": false,
            "os": false,
            "packageVersion": false
          },
          "gitBranch": {
            "maxLength": "full"
          },
          "gitCommit": {
            "hashLength": 7,
            "onlyDetached": true,
            "showTag": false
          },
          "gitMetrics": {
            "onlyNonzero": false,
            "ignoreSubmodules": false
          },
          "extensionStatuses": {
            "defaultPlacement": "right",
            "placements": {
              "perm": "left",
              "pi-guard": "left",
              "gatekeeper": "left",
              "playpen": "left",
              "mcp": "right",
              "masking": "off"
            },
            "colorModes": {
              "perm": "original",
              "usage": "original",
              "pi-guard": "original",
              "gatekeeper": "original",
              "mcp": "original",
              "playpen": "original",
              "masking": "original"
            }
          }
        }
      },
      "codexQuota": false
    },
    "selectorBorders": {
      "enabled": false,
      "style": "zentui",
      "colorSource": "terminal"
    },
    "thinkingSteps": {
      "enabled": true,
      "mode": "tree"
    },
    "toolDisplay": {
      "enabled": false,
      "style": "opencode",
      "registerToolOverrides": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "grep": true,
        "find": true,
        "ls": true
      },
      "builtinRendererOverrides": {
        "bash": true
      },
      "customToolOverrides": {},
      "readOutputMode": "hidden",
      "searchOutputMode": "hidden",
      "mcpOutputMode": "hidden",
      "bashOutputMode": "opencode",
      "previewLines": 8,
      "expandedPreviewMaxLines": 4000,
      "bashCollapsedLines": 10,
      "diffViewMode": "auto",
      "diffIndicatorMode": "bars",
      "diffSplitMinWidth": 120,
      "diffCollapsedLines": 24,
      "diffWordWrap": true,
      "showTruncationHints": false
    },
    "extensionStatuses": {
      "visibility": {
        "perm": "show",
        "gatekeeper": "show"
      }
    }
  },
  "icons": {
    "mode": "auto"
  }
}
