{
  "plugin": [
    "@slkiser/opencode-quota"
  ],
  "experimental": {
    "quotaToast": {
      "onlyCurrentModel": "true",
      "enableToast": false,
      "showSessionTokens": true,
      "enabledProviders": "auto",
      "formatStyle": "grouped",
      "percentDisplayMode": "remaining"
    }
  },
  "mcp": {
    "grafana": {
        "type": "local",
        "enabled": true,
        "command": ["mcp-grafana", "-disable-write"]
    }
  },
  "$schema": "https://opencode.ai/config.json"
}
