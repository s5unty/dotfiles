{
    "autoupdate": false,
    "compaction": {
        "auto": false,
        "prune": true,
        "reserved": 10000
    },
    "plugin": [
        "@slkiser/opencode-quota"
    ],
    "mcp": {
        "grafana": {
            "type": "local",
            "enabled": true,
            "command": [
                "mcp-grafana",
                "-disable-write"
            ]
        },
        "obsidian": {
            "type": "local",
            "enabled": true,
            "command": [
                "npx",
                "@bitbonsai/mcpvault@latest",
                "/sun/personal"
            ]
        }
    },
    "$schema": "https://opencode.ai/config.json"
}
