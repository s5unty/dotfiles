{
  "plugin": [
    "@slkiser/opencode-quota"
  ],
  "keybinds": {
    "app_exit": "ctrl+w",
    "command_list": "ctrl+o",
    "messages_first": "ctrl+g",
    "messages_last": "ctrl+alt+g",
    "messages_half_page_up": "ctrl+u",
    "messages_half_page_down": "ctrl+d",
    "input_line_home": "home",
    "input_line_end": "end",
    "input_buffer_home": "ctrl+home",
    "input_buffer_end": "ctrl+end",
    "input_undo": "ctrl+z",
    "input_redo": "ctrl+y",
    "history_previous": "ctrl+p",
    "history_next": "ctrl+n",
    "agent_list": "shift+tab",
    "model_list": "F3",
    "variant_list": "F4",
    "session_child_first": "F1",
    "session_child_cycle": "`",
    "session_child_cycle_reverse": "~",
    "session_parent": "esc",
    "session_list": "F5",
    "session_timeline": "F6",
    "terminal_suspend": "<leader>z",
    "display_thinking": "<leader>k",
    "leader": "ctrl+x"
  },
  "$schema": "https://opencode.ai/tui.json"
}
